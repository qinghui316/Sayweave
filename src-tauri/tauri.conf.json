{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sayweave",
  "version": "0.1.11",
  "identifier": "local.sayweave.skeleton",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Sayweave",
        "width": 1120,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#F6F6F6",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "capabilities": [
        "main",
        "overlay"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi"
      }
    },
    "publisher": "sayweave"
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVENjkzMzJDRTAxNERDRTcKUldUbjNCVGdMRE5wWGJ1OXFkbHk5WDRTanBKSWlMQnN6amdoaFVLQUhKZzIwTVNuYVZZUkV6VFUK",
      "endpoints": [
        "https://github.com/qinghui316/Sayweave/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
