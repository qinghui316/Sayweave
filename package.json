{
  "name": "sayweave",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts/*.mjs && node scripts/check-boundaries.mjs && node scripts/check-text.mjs",
    "test": "vitest run && npm run test:native",
    "test:ui": "vitest run",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "test:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-desktop.ps1",
    "test:learning:live": "node scripts/test-language-actor.mjs",
    "check:native": "node scripts/check-native-boundaries.mjs && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings && npm run test:native && npm run check:tsf",
    "check:tsf": "cargo fmt --manifest-path src-tauri/text-service/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/text-service/Cargo.toml --all-targets --features acceptance -- -D warnings && cargo test --manifest-path src-tauri/text-service/Cargo.toml",
    "test:tsf": "cargo build --manifest-path src-tauri/text-service/Cargo.toml --features acceptance && powershell -NoProfile -ExecutionPolicy Bypass -File src-tauri/text-service/test-stage-a.ps1",
    "build": "tsc --noEmit && vite build",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:package": "node scripts/desktop.mjs package",
    "desktop:release:manifest": "node scripts/generate-update-manifest.mjs",
    "desktop:release:verify": "node scripts/verify-update-release.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:ui && npm run check:native && npm run build",
    "check:distribution": "node scripts/check-distribution.mjs",
    "tauri": "tauri",
    "test:input": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-input.ps1",
    "test:composition": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-input.ps1 -CompositionOnly"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.21",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-updater": "2.13.2",
    "lucide": "1.51.0",
    "morphicons": "1.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
